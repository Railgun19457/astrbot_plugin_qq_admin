{
  "enabled": {
    "type": "bool",
    "description": "启用插件",
    "hint": "关闭后所有指令与 LLM 工具都不会响应",
    "default": true
  },
  "llm_tool_options": {
    "type": "list",
    "description": "函数工具选项",
    "hint": "选择暴露给 LLM 的工具。默认全部关闭：非内置工具默认不受权限门控，开启前请确认使用者可信，并建议在「扩展 → 组件」中设为 admin",
    "options": [
      "qq_ban_member",
      "qq_whole_ban",
      "qq_kick_member",
      "qq_recall_message",
      "qq_send_group_notice",
      "qq_blacklist_add",
      "qq_blacklist_remove",
      "qq_blacklist_query",
      "qq_group_info",
      "qq_member_list"
    ],
    "default": []
  },
  "group_sets": {
    "type": "template_list",
    "description": "群组定义",
    "hint": "插件只对这里配置的群生效",
    "templates": {
      "group_set": {
        "name": "群组",
        "display_item": "name",
        "items": {
          "name": {
            "type": "string",
            "description": "群组名称",
            "hint": "仅用于显示",
            "default": ""
          },
          "group_ids": {
            "type": "list",
            "items": {
              "type": "string"
            },
            "description": "群号列表",
            "hint": "同一群号不要重复出现在多个群组里",
            "default": []
          },
          "manage_session": {
            "type": "string",
            "description": "管理会话",
            "hint": "群管理员专用的会话 UMO，在目标会话发送 /sid 获取，例如 aiocqhttp:GroupMessage:123456。审核通知默认发到这里，其中的「黑名单 / 拉黑 / 解除拉黑 / 群管状态」对该群组生效，发送「黑名单 通知设置」可查看通知路由；留空则通知发到申请所在群，且只能在各群内管理",
            "default": ""
          },
          "default_ban_duration": {
            "type": "string",
            "description": "默认禁言时长",
            "hint": "支持 600（秒）、10m、2h、1d 等写法",
            "default": "10m"
          },
          "blacklist": {
            "type": "object",
            "description": "黑名单",
            "items": {
              "enabled": {
                "type": "bool",
                "description": "启用黑名单",
                "hint": "关闭后拉黑与查询会直接拒绝，撤回和审核拒绝同时失效；已有条目保留",
                "default": true
              },
              "default_reason": {
                "type": "string",
                "description": "默认拉黑原因",
                "hint": "指令或工具未提供原因时使用的文案",
                "default": "未填写原因"
              },
              "block_message": {
                "type": "bool",
                "description": "撤回黑名单成员的群消息",
                "hint": "黑名单成员发言后立即撤回（需撤回权限）；不会阻止其他插件或模型处理该消息",
                "default": false
              },
              "kick_on_add": {
                "type": "bool",
                "description": "拉黑后自动踢出群聊",
                "hint": "拉黑成功后把目标移出当前群（需踢人权限）；只作用于执行拉黑的群",
                "default": false
              }
            }
          },
          "join_review": {
            "type": "object",
            "description": "自动进群审核",
            "hint": "本群组的通用规则，对组内所有群生效；未加入群组的群不会自动审核",
            "items": {
              "enabled": {
                "type": "bool",
                "description": "启用进群审核",
                "default": false
              },
              "blacklist_reject": {
                "type": "bool",
                "description": "黑名单成员自动拒绝",
                "hint": "申请人处于本群组黑名单中时直接拒绝（需启用黑名单）",
                "default": true
              },
              "keyword_allow": {
                "type": "bool",
                "description": "答案匹配关键词时自动放行",
                "default": true
              },
              "keywords": {
                "type": "list",
                "items": {
                  "type": "string"
                },
                "description": "放行关键词",
                "hint": "直接填写对所有群生效；写成「群号:关键词」只对该群生效，例如 123456:答案",
                "default": []
              },
              "question_type": {
                "type": "string",
                "description": "关键词适用的申请类型",
                "hint": "any=全部，add=主动申请，invite=被邀请",
                "options": [
                  "any",
                  "add",
                  "invite"
                ],
                "default": "any"
              },
              "min_account_level": {
                "type": "int",
                "description": "最低 QQ 等级",
                "hint": "0 表示不检查；需协议端支持 level 字段，不支持时跳过并警告",
                "default": 0
              },
              "default_action": {
                "type": "string",
                "description": "默认行为",
                "hint": "未命中黑名单、跨群免审核与关键词时的处理方式：hold=保持待审（安静地记入待办，不会主动提示；只有「通知与回执」勾选了「进群审核通知」才发送人工审核消息），approve=直接放行，reject=直接拒绝",
                "options": [
                  "hold",
                  "approve",
                  "reject"
                ],
                "default": "hold",
                "obvious_hint": true
              },
              "reject_reason": {
                "type": "string",
                "description": "拒绝理由",
                "default": "未通过进群审核"
              },
              "exemptions": {
                "type": "list",
                "items": {
                  "type": "string"
                },
                "description": "跨群免审核",
                "hint": "直接填来源群号（逗号分隔）对所有群生效；写成「目标群:来源群1,来源群2」只对该目标群生效。命中后直接通过，黑名单优先",
                "default": []
              }
            }
          }
        }
      }
    }
  },
  "permissions": {
    "type": "object",
    "description": "权限设置",
    "items": {
      "custom_whitelist": {
        "type": "list",
        "items": {
          "type": "string"
        },
        "description": "自定义用户白名单",
        "hint": "这些 QQ 号拥有等同 AstrBot 管理员的权限，可使用全部指令",
        "default": []
      },
      "allow_astrbot_admin": {
        "type": "bool",
        "description": "允许 AstrBot 全局管理员",
        "hint": "AstrBot 配置里的 admins_id 列表",
        "default": true
      },
      "allow_group_admin": {
        "type": "bool",
        "description": "允许群主与群管理员",
        "hint": "按 OneBot 返回的 owner / admin 角色判定",
        "default": true
      },
      "allow_member_command": {
        "type": "bool",
        "description": "允许普通成员使用查询类指令",
        "hint": "仅影响「任何人」级别的查询指令",
        "default": true
      },
      "capability_level": {
        "type": "dict",
        "description": "各能力所需权限等级",
        "items": {},
        "template_schema": {
          "ban": {
            "name": "禁言",
            "description": "禁言与解禁普通成员",
            "type": "string",
            "default": "group_admin",
            "options": [
              "any",
              "group_admin",
              "astrbot_admin"
            ]
          },
          "whole_ban": {
            "name": "全群禁言",
            "description": "开启或解除全群禁言",
            "type": "string",
            "default": "group_admin",
            "options": [
              "any",
              "group_admin",
              "astrbot_admin"
            ]
          },
          "kick": {
            "name": "踢人",
            "description": "将成员移出本群",
            "type": "string",
            "default": "group_admin",
            "options": [
              "any",
              "group_admin",
              "astrbot_admin"
            ]
          },
          "recall": {
            "name": "撤回消息",
            "description": "撤回群内消息",
            "type": "string",
            "default": "group_admin",
            "options": [
              "any",
              "group_admin",
              "astrbot_admin"
            ]
          },
          "notice": {
            "name": "群公告",
            "description": "发送与查看群公告",
            "type": "string",
            "default": "group_admin",
            "options": [
              "any",
              "group_admin",
              "astrbot_admin"
            ]
          },
          "blacklist": {
            "name": "黑名单增删",
            "description": "添加与移除黑名单成员",
            "type": "string",
            "default": "group_admin",
            "options": [
              "any",
              "group_admin",
              "astrbot_admin"
            ]
          },
          "query": {
            "name": "查询",
            "description": "查看黑名单、群信息、运行状态等只读信息",
            "type": "string",
            "default": "any",
            "options": [
              "any",
              "group_admin",
              "astrbot_admin"
            ]
          },
          "review": {
            "name": "进群审核",
            "description": "查看与处理待审核的进群申请",
            "type": "string",
            "default": "group_admin",
            "options": [
              "any",
              "group_admin",
              "astrbot_admin"
            ]
          },
          "export": {
            "name": "导出表格",
            "description": "导出成员名单与黑名单表格",
            "type": "string",
            "default": "astrbot_admin",
            "options": [
              "any",
              "group_admin",
              "astrbot_admin"
            ]
          }
        }
      }
    }
  },
  "confirm": {
    "type": "object",
    "description": "高危操作确认",
    "items": {
      "enabled": {
        "type": "bool",
        "description": "启用二次确认",
        "default": true
      },
      "timeout": {
        "type": "int",
        "description": "确认超时（秒）",
        "hint": "超时视为取消，范围 5-600",
        "default": 60
      },
      "require_for": {
        "type": "list",
        "description": "需要确认的操作",
        "hint": "whole_ban 指「禁言 全体」，kick 指踢人",
        "options": [
          "kick",
          "whole_ban"
        ],
        "default": [
          "kick",
          "whole_ban"
        ]
      },
      "confirm_words": {
        "type": "list",
        "items": {
          "type": "string"
        },
        "description": "确认词",
        "default": [
          "同意",
          "确认",
          "yes"
        ]
      },
      "cancel_words": {
        "type": "list",
        "items": {
          "type": "string"
        },
        "description": "取消词",
        "hint": "同时用于进群审核通知的「拒绝」回复",
        "default": [
          "取消",
          "拒绝",
          "否",
          "no"
        ]
      }
    }
  },
  "export": {
    "type": "object",
    "description": "表格导出",
    "items": {
      "upload_to_group": {
        "type": "bool",
        "description": "上传到群文件",
        "hint": "关闭后只回复本地文件路径",
        "default": true
      },
      "max_members": {
        "type": "int",
        "description": "成员名单导出行数上限",
        "hint": "超大群导出会很慢且文件很大，超出部分会被截断并在表格中标注",
        "default": 3000
      },
      "cleanup_hours": {
        "type": "int",
        "description": "导出文件保留时长（小时）",
        "hint": "启动时清理，0 表示不清理",
        "default": 24
      }
    }
  },
  "notify": {
    "type": "object",
    "description": "通知与回执",
    "hint": "各项含义：禁言=禁言/解禁/全群禁言回执；踢人=/踢 回执；撤回=/撤回 回执；黑名单=/拉黑、/解除拉黑 回执与拉黑后自动踢出结果；群导出=/群导出 回执；进群审核通知=新进群申请、其自动处理结果，以及引用通知处理申请后的结果（跟随审核通知所在会话）。每项可分别选择发到当前会话、发到群组配置的管理会话，或两者都发；两个都不勾选则不发送",
    "items": {
      "to_current_session": {
        "type": "list",
        "description": "发到当前会话",
        "hint": "指令在哪个会话执行，回执就发到哪个会话；审核通知则是发到申请所在的群",
        "options": [
          "禁言",
          "踢人",
          "撤回",
          "黑名单",
          "群导出",
          "进群审核通知"
        ],
        "default": [
          "禁言",
          "踢人",
          "撤回",
          "黑名单",
          "群导出"
        ]
      },
      "to_manage_session": {
        "type": "list",
        "description": "发到管理会话",
        "hint": "需在群组里配置管理会话；未配置时自动改发当前会话",
        "options": [
          "禁言",
          "踢人",
          "撤回",
          "黑名单",
          "群导出",
          "进群审核通知"
        ],
        "default": [
          "进群审核通知"
        ]
      }
    }
  },
  "audit": {
    "type": "object",
    "description": "审计日志",
    "items": {
      "enabled": {
        "type": "bool",
        "description": "记录审计日志",
        "hint": "记录到插件数据目录下的 audit.jsonl",
        "default": true
      },
      "retention_days": {
        "type": "int",
        "description": "保留天数",
        "hint": "启动时清理，0 表示不清理",
        "default": 30
      }
    }
  },
  "templates": {
    "type": "object",
    "description": "消息模板",
    "hint": "占位符用花括号，例如 {target_name}。渲染失败会自动回退到默认文案",
    "items": {
      "ban_success": {
        "type": "text",
        "description": "禁言成功",
        "hint": "可用占位符：{target_name} {target_id} {duration}",
        "default": "已禁言 {target_name}({target_id}) {duration}"
      },
      "unban_success": {
        "type": "text",
        "description": "解禁成功",
        "hint": "可用占位符：{target_name} {target_id}",
        "default": "已解除 {target_name}({target_id}) 的禁言"
      },
      "whole_ban_on": {
        "type": "text",
        "description": "全群禁言已开启",
        "default": "已开启全群禁言"
      },
      "whole_ban_off": {
        "type": "text",
        "description": "全群禁言已解除",
        "default": "已解除全群禁言"
      },
      "whole_ban_timed": {
        "type": "text",
        "description": "全群禁言已开启（定时）",
        "hint": "可用占位符：{duration}",
        "default": "已开启全群禁言，将在 {duration} 后自动解除"
      },
      "kick_success": {
        "type": "text",
        "description": "踢人成功",
        "hint": "可用占位符：{target_name} {target_id}",
        "default": "已将 {target_name}({target_id}) 移出本群"
      },
      "recall_success": {
        "type": "text",
        "description": "撤回成功",
        "default": "已撤回指定消息"
      },
      "notice_success": {
        "type": "text",
        "description": "群公告发送成功",
        "default": "群公告已更新"
      },
      "no_permission": {
        "type": "text",
        "description": "权限不足",
        "hint": "可用占位符：{reason}",
        "default": "你没有权限执行该操作：{reason}"
      },
      "no_target": {
        "type": "text",
        "description": "未指定目标",
        "default": "请 @ 一个目标，或回复对方的消息后再执行本指令"
      },
      "blacklist_added": {
        "type": "text",
        "description": "拉黑成功",
        "hint": "可用占位符：{target_name} {target_id} {reason} {duration}",
        "default": "已将 {target_name}({target_id}) 加入黑名单\n原因：{reason}\n期限：{duration}"
      },
      "blacklist_removed": {
        "type": "text",
        "description": "移出黑名单",
        "hint": "可用占位符：{target_name} {target_id}",
        "default": "已将 {target_name}({target_id}) 移出黑名单"
      },
      "blacklist_not_found": {
        "type": "text",
        "description": "目标不在黑名单",
        "hint": "可用占位符：{target_name} {target_id}",
        "default": "{target_name}({target_id}) 不在黑名单中"
      },
      "blacklist_empty": {
        "type": "text",
        "description": "黑名单为空",
        "hint": "可用占位符：{scope}",
        "default": "黑名单（{scope}）当前为空"
      },
      "blacklist_disabled": {
        "type": "text",
        "description": "黑名单功能已关闭",
        "hint": "群组关闭黑名单后，拉黑指令与工具返回的提示",
        "default": "黑名单功能已在插件配置中关闭"
      },
      "blacklist_header": {
        "type": "text",
        "description": "黑名单列表头部",
        "hint": "可用占位符：{scope} {count} {groups}",
        "default": "黑名单（{scope}）共 {count} 人，覆盖 {groups} 个群"
      },
      "bad_duration": {
        "type": "text",
        "description": "时长格式错误",
        "default": "时长格式不正确，示例：10m、2h、1d、600"
      },
      "api_failed": {
        "type": "text",
        "description": "接口调用失败",
        "hint": "可用占位符：{error}",
        "default": "操作失败：{error}"
      },
      "api_unsupported": {
        "type": "text",
        "description": "协议端不支持该接口",
        "default": "当前协议端不支持该操作，建议改用 NapCat 或 Lagrange"
      },
      "confirm_prompt": {
        "type": "text",
        "description": "二次确认提示",
        "hint": "可用占位符：{summary} {timeout}",
        "default": "即将执行：{summary}\n回复「同意」继续，回复「取消」放弃（{timeout} 秒内有效）"
      },
      "confirm_timeout": {
        "type": "text",
        "description": "确认超时",
        "default": "操作已取消（等待确认超时）"
      },
      "confirm_cancelled": {
        "type": "text",
        "description": "操作已取消",
        "default": "操作已取消"
      },
      "confirm_not_operator": {
        "type": "text",
        "description": "非操作者尝试确认",
        "default": "只有发起该操作的人可以确认"
      },
      "review_new_request": {
        "type": "text",
        "description": "进群申请通知",
        "hint": "可用占位符：{group_id} {user_id} {comment} {sub_type} {decision} {reason}",
        "default": "【进群申请】群 {group_id}\n申请人：{user_id}\n答案：{comment}\n处理：{decision}（{reason}）"
      },
      "review_decided": {
        "type": "text",
        "description": "人工审核完成",
        "hint": "可用占位符：{action} {user_id} {group_id}",
        "default": "已{action} {user_id} 加入群 {group_id} 的申请"
      },
      "review_pending_hint": {
        "type": "text",
        "description": "待人工确认提示",
        "hint": "提示用户引用通知消息回复同意/拒绝",
        "default": "引用本条消息回复「同意」或「拒绝」即可处理"
      },
      "manage_unsupported": {
        "type": "text",
        "description": "管理会话不支持该指令",
        "default": "该指令需要在目标群内执行。管理会话仅支持：审核、黑名单、拉黑、解除拉黑、群管状态"
      },
      "manage_ambiguous": {
        "type": "text",
        "description": "管理会话对应多个群组",
        "hint": "可用占位符：{names}",
        "default": "该管理会话同时对应多个群组（{names}），请写明群号或群组名再试"
      },
      "group_not_found": {
        "type": "text",
        "description": "找不到指定群组",
        "hint": "可用占位符：{selector}",
        "default": "未找到群组：{selector}"
      },
      "notification_settings": {
        "type": "text",
        "description": "通知设置提示",
        "hint": "提醒在管理会话里可以查看某个群组的通知路由",
        "default": "在管理会话发送「黑名单 通知设置 [群号或群组名]」可查看该群组的通知路由"
      },
      "member_list_failed": {
        "type": "text",
        "description": "获取群成员失败",
        "default": "无法获取群成员列表，请稍后重试"
      },
      "export_success": {
        "type": "text",
        "description": "导出并上传成功",
        "hint": "可用占位符：{kind} {count}",
        "default": "已导出{kind}表格（{count} 条）并上传到群文件"
      },
      "export_local_only": {
        "type": "text",
        "description": "导出成功但上传失败",
        "hint": "可用占位符：{kind} {count} {path}",
        "default": "已生成{kind}表格（{count} 条），但上传失败。\n本地路径：{path}"
      },
      "export_empty": {
        "type": "text",
        "description": "无可导出数据",
        "hint": "可用占位符：{kind}",
        "default": "{kind}为空，没有可导出的数据"
      },
      "export_failed": {
        "type": "text",
        "description": "导出失败",
        "hint": "可用占位符：{error}",
        "default": "导出失败：{error}"
      },
      "review_reply_ambiguous": {
        "type": "text",
        "description": "多条待办时要求引用",
        "hint": "可用占位符：{count}",
        "default": "当前有 {count} 条待处理申请，请引用对应的通知消息后再回复同意/拒绝"
      }
    }
  }
}
