{
  "enabled": {
    "type": "bool",
    "description": "启用插件",
    "hint": "关闭后所有指令与 LLM 工具都不响应",
    "default": true
  },
  "llm_tool_options": {
    "type": "list",
    "description": "函数工具选项",
    "hint": "默认全部关闭；非内置工具不受框架权限门控，开启前请确认使用者可信，并建议在「扩展 → 组件」中设为 admin",
    "options": [
      "qq_ban_member",
      "qq_whole_ban",
      "qq_kick_member",
      "qq_send_group_notice",
      "qq_group_notice_query",
      "qq_group_notice_delete",
      "qq_blacklist_add",
      "qq_blacklist_remove",
      "qq_blacklist_query",
      "qq_group_info",
      "qq_member_list"
    ],
    "default": []
  },
  "group_sets": {
    "type": "template_list",
    "description": "群组定义",
    "hint": "插件只对这里配置的群生效；同一群号写在多个群组里时以先配置的为准",
    "templates": {
      "group_set": {
        "name": "群组",
        "display_item": "name",
        "items": {
          "name": {
            "type": "string",
            "description": "群组名称",
            "hint": "仅用于显示与黑名单分组：同名群组共享黑名单，留空自动命名",
            "default": ""
          },
          "group_ids": {
            "type": "list",
            "items": {
              "type": "string"
            },
            "description": "群号列表",
            "hint": "填群号（如 123456）对所有 QQ 实例生效；填会话 UMO（如 aiocqhttp:GroupMessage:123456，在目标群发 /sid 获取）则只对该实例生效",
            "default": []
          },
          "manage_session": {
            "type": "string",
            "description": "管理会话",
            "hint": "群管理员控制台的会话 UMO（发 /sid 获取）。指令集与群内一致，需指定群时加 #群号；留空则通知发到申请所在群",
            "default": ""
          },
          "default_ban_duration": {
            "type": "string",
            "description": "默认禁言时长",
            "hint": "未指定时长时使用；支持 600、10m、2h、1d",
            "default": "10m"
          },
          "blacklist": {
            "type": "object",
            "description": "黑名单",
            "items": {
              "enabled": {
                "type": "bool",
                "description": "启用黑名单",
                "hint": "关闭后拉黑与查询直接拒绝，撤回与审核拒绝同时失效；已有条目保留",
                "default": true
              },
              "default_reason": {
                "type": "string",
                "description": "默认拉黑原因",
                "hint": "指令或工具未填原因时使用",
                "default": "未填写原因"
              },
              "block_message": {
                "type": "bool",
                "description": "撤回黑名单成员的群消息",
                "hint": "成员发言后立即撤回（需撤回权限）；不影响其他插件或模型",
                "default": false
              },
              "kick_on_add": {
                "type": "string",
                "description": "拉黑后踢出",
                "hint": "none=不踢；current=只踢执行拉黑的群；all=踢该群组所有群",
                "options": [
                  "none",
                  "current",
                  "all"
                ],
                "default": "none"
              }
            },
            "hint": "组内所有群共享；拉黑永久有效，用「解除拉黑」移出"
          },
          "join_review": {
            "type": "object",
            "description": "自动进群审核",
            "hint": "本群组通用规则，对组内所有群生效",
            "items": {
              "enabled": {
                "type": "bool",
                "description": "启用进群审核",
                "default": false,
                "hint": "开启后按下列规则自动处理新申请"
              },
              "blacklist_reject": {
                "type": "bool",
                "description": "黑名单成员自动拒绝",
                "hint": "申请人在本群组黑名单中时直接拒绝（需启用黑名单）",
                "default": true
              },
              "keyword_allow": {
                "type": "bool",
                "description": "答案匹配关键词时自动放行",
                "default": true,
                "hint": "关闭后命中关键词也不放行"
              },
              "keywords": {
                "type": "list",
                "items": {
                  "type": "string"
                },
                "description": "放行关键词",
                "hint": "直接填写全群组生效；写成「群号:关键词」只对该群生效",
                "default": []
              },
              "question_type": {
                "type": "string",
                "description": "关键词适用的申请类型",
                "hint": "any=全部，add=主动申请，invite=被邀请",
                "options": [
                  "any",
                  "add",
                  "invite"
                ],
                "default": "any"
              },
              "min_account_level": {
                "type": "int",
                "description": "最低 QQ 等级",
                "hint": "0 表示不检查；需协议端支持 level 字段",
                "default": 0
              },
              "default_action": {
                "type": "string",
                "description": "默认行为",
                "hint": "hold=保持待审（安静入队，需引用通知处理）；approve=放行；reject=拒绝。是否发通知由「通知与回执」决定",
                "options": [
                  "hold",
                  "approve",
                  "reject"
                ],
                "default": "hold",
                "obvious_hint": true
              },
              "reject_reason": {
                "type": "string",
                "description": "拒绝理由",
                "default": "未通过进群审核",
                "hint": "拒绝时展示给申请人；留空用默认文案"
              },
              "exemptions": {
                "type": "list",
                "items": {
                  "type": "string"
                },
                "description": "跨群免审核",
                "hint": "填来源群号（逗号分隔）对所有群生效；写「目标群:来源群」只对该目标群生效",
                "default": []
              }
            }
          }
        }
      }
    }
  },
  "permissions": {
    "type": "object",
    "description": "权限设置",
    "items": {
      "custom_whitelist": {
        "type": "list",
        "items": {
          "type": "string"
        },
        "description": "自定义用户白名单",
        "hint": "等同 AstrBot 管理员，可使用全部指令",
        "default": []
      },
      "allow_astrbot_admin": {
        "type": "bool",
        "description": "允许 AstrBot 全局管理员",
        "hint": "AstrBot 配置中的 admins_id",
        "default": true
      },
      "allow_group_admin": {
        "type": "bool",
        "description": "允许群主与群管理员",
        "hint": "按 OneBot 的 owner / admin 角色判定",
        "default": true
      },
      "allow_member_command": {
        "type": "bool",
        "description": "允许普通成员使用查询类指令",
        "hint": "仅影响「任何人」级别的查询指令",
        "default": true
      },
      "capability_level": {
        "type": "dict",
        "description": "各能力所需权限等级",
        "items": {},
        "template_schema": {
          "ban": {
            "name": "禁言",
            "description": "禁言与解禁普通成员",
            "type": "string",
            "default": "group_admin",
            "options": [
              "any",
              "group_admin",
              "astrbot_admin"
            ]
          },
          "whole_ban": {
            "name": "全群禁言",
            "description": "开启或解除全群禁言",
            "type": "string",
            "default": "group_admin",
            "options": [
              "any",
              "group_admin",
              "astrbot_admin"
            ]
          },
          "kick": {
            "name": "踢人",
            "description": "将成员移出本群",
            "type": "string",
            "default": "group_admin",
            "options": [
              "any",
              "group_admin",
              "astrbot_admin"
            ]
          },
          "recall": {
            "name": "撤回消息",
            "description": "撤回群内消息",
            "type": "string",
            "default": "group_admin",
            "options": [
              "any",
              "group_admin",
              "astrbot_admin"
            ]
          },
          "notice": {
            "name": "群公告",
            "description": "向群内发送公告（仅 LLM 工具）",
            "type": "string",
            "default": "group_admin",
            "options": [
              "any",
              "group_admin",
              "astrbot_admin"
            ]
          },
          "blacklist": {
            "name": "黑名单增删",
            "description": "添加与移除黑名单成员",
            "type": "string",
            "default": "group_admin",
            "options": [
              "any",
              "group_admin",
              "astrbot_admin"
            ]
          },
          "query": {
            "name": "查询",
            "description": "查看黑名单、群信息、运行状态等只读信息",
            "type": "string",
            "default": "any",
            "options": [
              "any",
              "group_admin",
              "astrbot_admin"
            ]
          },
          "review": {
            "name": "进群审核",
            "description": "处理待审核的进群申请（引用通知回复同意/拒绝）",
            "type": "string",
            "default": "group_admin",
            "options": [
              "any",
              "group_admin",
              "astrbot_admin"
            ]
          },
          "export": {
            "name": "导出表格",
            "description": "导出成员名单与黑名单表格",
            "type": "string",
            "default": "astrbot_admin",
            "options": [
              "any",
              "group_admin",
              "astrbot_admin"
            ]
          }
        },
        "hint": "any=任何人；group_admin=群主或群管理员；astrbot_admin=仅 AstrBot 管理员与白名单"
      }
    },
    "hint": "指令默认允许 AstrBot 管理员、白名单用户与群主/群管理员使用，查询类指令默认也允许普通成员"
  },
  "confirm": {
    "type": "object",
    "description": "高危操作确认",
    "items": {
      "enabled": {
        "type": "bool",
        "description": "启用二次确认",
        "default": true,
        "hint": "关闭后踢人与全群禁言直接执行"
      },
      "timeout": {
        "type": "int",
        "description": "确认超时（秒）",
        "hint": "超时视为取消，范围 5-600",
        "default": 60
      },
      "require_for": {
        "type": "list",
        "description": "需要确认的操作",
        "hint": "whole_ban=「禁言 全体」，kick=踢人",
        "options": [
          "kick",
          "whole_ban"
        ],
        "default": [
          "kick",
          "whole_ban"
        ]
      },
      "confirm_words": {
        "type": "list",
        "items": {
          "type": "string"
        },
        "description": "确认词",
        "default": [
          "同意",
          "确认",
          "yes"
        ],
        "hint": "进群审核通知的「同意」回复也用这里"
      },
      "cancel_words": {
        "type": "list",
        "items": {
          "type": "string"
        },
        "description": "取消词",
        "hint": "进群审核通知的「拒绝」回复也用这里",
        "default": [
          "取消",
          "拒绝",
          "否",
          "no"
        ]
      }
    },
    "hint": "踢人与全群禁言默认需要发起人二次确认；确认词与取消词同时用于进群审核通知的回复"
  },
  "export": {
    "type": "object",
    "description": "表格导出",
    "items": {
      "upload_to_group": {
        "type": "bool",
        "description": "上传到群文件",
        "hint": "关闭后只回复本地文件路径",
        "default": true
      },
      "max_members": {
        "type": "int",
        "description": "成员名单导出行数上限",
        "hint": "每个群的上限，超出部分截断并在表格中标注",
        "default": 3000
      },
      "cleanup_hours": {
        "type": "int",
        "description": "导出文件保留时长（小时）",
        "hint": "启动时清理，0 表示不清理",
        "default": 24
      }
    },
    "hint": "导出当前会话能看到的全部内容：群里导出本群（黑名单为整个群组），管理会话里导出它管理的所有群；成员名单按群分表放在同一个文件里"
  },
  "notify": {
    "type": "object",
    "description": "通知与回执",
    "hint": "两类通知的触发方式不同：指令回执永远在执行指令的会话答复，可在下面勾选额外转发到管理会话；进群审核通知由申请人触发，需要单独选择发到哪里",
    "items": {
      "receipt_to_manage_session": {
        "type": "list",
        "description": "回执额外发到管理会话",
        "hint": "勾选的内容在答复执行会话之外，再发一份到管理会话（在管理会话执行时不重复发）",
        "options": [
          "禁言",
          "踢人",
          "撤回",
          "黑名单",
          "导出"
        ],
        "default": []
      },
      "review_notice_target": {
        "type": "string",
        "description": "进群审核通知发送到",
        "hint": "origin=申请所在群；manage=管理会话（未配置时回退申请所在群）；both=都发；none=不发。新申请与处理结果都跟随此处",
        "options": [
          "origin",
          "manage",
          "both",
          "none"
        ],
        "default": "manage",
        "obvious_hint": true
      }
    }
  },
  "audit": {
    "type": "object",
    "description": "审计日志",
    "items": {
      "enabled": {
        "type": "bool",
        "description": "记录审计日志",
        "hint": "写入插件数据目录的 audit.jsonl",
        "default": true
      },
      "retention_days": {
        "type": "int",
        "description": "保留天数",
        "hint": "启动时清理，0 表示不清理",
        "default": 30
      }
    },
    "hint": "记录谁在哪个群执行了什么，写入插件数据目录的 audit.jsonl"
  },
  "templates": {
    "type": "object",
    "description": "消息模板",
    "hint": "占位符用花括号，例如 {target_name}；渲染失败会自动回退到默认文案",
    "items": {
      "ban_success": {
        "type": "text",
        "description": "禁言成功",
        "hint": "占位符：{target_name} {target_id} {duration}",
        "default": "已禁言 {target_name}({target_id}) {duration}"
      },
      "unban_success": {
        "type": "text",
        "description": "解禁成功",
        "hint": "占位符：{target_name} {target_id}",
        "default": "已解除 {target_name}({target_id}) 的禁言"
      },
      "whole_ban_on": {
        "type": "text",
        "description": "全群禁言已开启",
        "default": "已开启全群禁言",
        "hint": ""
      },
      "whole_ban_off": {
        "type": "text",
        "description": "全群禁言已解除",
        "default": "已解除全群禁言",
        "hint": ""
      },
      "whole_ban_timed": {
        "type": "text",
        "description": "全群禁言已开启（定时）",
        "hint": "占位符：{duration}",
        "default": "已开启全群禁言，将在 {duration} 后自动解除"
      },
      "kick_success": {
        "type": "text",
        "description": "踢人成功",
        "hint": "占位符：{target_name} {target_id}",
        "default": "已将 {target_name}({target_id}) 移出本群"
      },
      "recall_success": {
        "type": "text",
        "description": "撤回成功",
        "default": "已撤回指定消息",
        "hint": ""
      },
      "notice_success": {
        "type": "text",
        "description": "群公告发送成功",
        "default": "群公告已更新",
        "hint": ""
      },
      "no_permission": {
        "type": "text",
        "description": "权限不足",
        "hint": "占位符：{reason}",
        "default": "你没有权限执行该操作：{reason}"
      },
      "no_target": {
        "type": "text",
        "description": "未指定目标",
        "default": "请 @ 一个目标、引用对方消息，或直接填写 QQ 号",
        "hint": ""
      },
      "blacklist_added": {
        "type": "text",
        "description": "拉黑成功",
        "hint": "占位符：{target_name} {target_id} {reason}",
        "default": "已将 {target_name}({target_id}) 加入黑名单\n原因：{reason}"
      },
      "blacklist_removed": {
        "type": "text",
        "description": "移出黑名单",
        "hint": "占位符：{target_name} {target_id}",
        "default": "已将 {target_name}({target_id}) 移出黑名单"
      },
      "blacklist_not_found": {
        "type": "text",
        "description": "目标不在黑名单",
        "hint": "占位符：{target_name} {target_id}",
        "default": "{target_name}({target_id}) 不在黑名单中"
      },
      "blacklist_empty": {
        "type": "text",
        "description": "黑名单为空",
        "hint": "占位符：{scope}",
        "default": "黑名单（{scope}）当前为空"
      },
      "blacklist_disabled": {
        "type": "text",
        "description": "黑名单功能已关闭",
        "hint": "",
        "default": "黑名单已在插件配置中关闭"
      },
      "blacklist_header": {
        "type": "text",
        "description": "黑名单列表头部",
        "hint": "占位符：{scope} {count} {groups}",
        "default": "黑名单（{scope}）共 {count} 人，覆盖 {groups} 个群"
      },
      "bad_duration": {
        "type": "text",
        "description": "时长格式错误",
        "default": "时长格式不正确，示例：10m、2h、1d、600",
        "hint": ""
      },
      "api_failed": {
        "type": "text",
        "description": "接口调用失败",
        "hint": "占位符：{error}",
        "default": "操作失败：{error}"
      },
      "api_unsupported": {
        "type": "text",
        "description": "协议端不支持该接口",
        "default": "当前协议端不支持该操作（建议 NapCat 或 Lagrange）",
        "hint": ""
      },
      "confirm_prompt": {
        "type": "text",
        "description": "二次确认提示",
        "hint": "占位符：{summary} {timeout}",
        "default": "即将执行：{summary}\n回复「同意」继续，「取消」放弃（{timeout} 秒内有效）"
      },
      "confirm_timeout": {
        "type": "text",
        "description": "确认超时",
        "default": "操作已取消（等待确认超时）",
        "hint": ""
      },
      "confirm_cancelled": {
        "type": "text",
        "description": "操作已取消",
        "default": "操作已取消",
        "hint": ""
      },
      "confirm_not_operator": {
        "type": "text",
        "description": "非操作者尝试确认",
        "default": "只有发起该操作的人可以确认",
        "hint": ""
      },
      "review_new_request": {
        "type": "text",
        "description": "进群申请通知",
        "hint": "占位符：{group_id} {user_id} {user_name} {comment} {sub_type} {decision} {reason}",
        "default": "【进群申请】群 {group_id}\n申请人：{user_id}\n答案：{comment}\n处理：{decision}（{reason}）"
      },
      "review_decided": {
        "type": "text",
        "description": "人工审核完成",
        "hint": "占位符：{action} {user_id} {group_id}",
        "default": "已{action} {user_id} 加入群 {group_id} 的申请"
      },
      "review_pending_hint": {
        "type": "text",
        "description": "待审通知的回复提示",
        "hint": "贴在「保持待审」通知末尾",
        "default": "引用本条消息回复「同意」或「拒绝」即可处理"
      },
      "group_not_found": {
        "type": "text",
        "description": "找不到指定群组",
        "hint": "占位符：{selector}",
        "default": "未找到群组：{selector}"
      },
      "member_list_failed": {
        "type": "text",
        "description": "获取群成员失败",
        "default": "无法获取群成员列表，请稍后重试",
        "hint": ""
      },
      "export_success": {
        "type": "text",
        "description": "导出并上传成功",
        "hint": "占位符：{kind} {count}",
        "default": "已导出{kind}表格（{count} 条）并上传到群文件"
      },
      "export_local_only": {
        "type": "text",
        "description": "导出成功但上传失败",
        "hint": "占位符：{kind} {count} {path}",
        "default": "已生成{kind}表格（{count} 条），上传失败。\n本地路径：{path}"
      },
      "export_empty": {
        "type": "text",
